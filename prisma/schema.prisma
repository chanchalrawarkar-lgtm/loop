generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users    User[]
  feedback Feedback[]
  themes   Theme[]
  reports  Report[]
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String
  role        Role     @default(VIEWER)
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model Feedback {
  id             String         @id @default(cuid())
  content        String
  channel        String
  sourceRef      String?
  customerLabel  String?
  sentiment      Sentiment      @default(NEU)
  sentimentScore Float?
  status         FeedbackStatus @default(NEW)
  createdAt      DateTime       @default(now())
  workspaceId    String

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  themes    FeedbackTheme[]
  embedding Embedding?

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, createdAt])
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  description String?
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  feedback  FeedbackTheme[]

  @@index([workspaceId])
}

model FeedbackTheme {
  feedbackId String
  themeId    String

  feedback Feedback @relation(fields: [feedbackId], references: [id])
  theme    Theme    @relation(fields: [themeId], references: [id])

  @@id([feedbackId, themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id])
}

model Report {
  id          String   @id @default(cuid())
  title       String
  content     String
  periodStart DateTime?
  periodEnd   DateTime?
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}